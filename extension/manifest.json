{
  "manifest_version": 3,
  "name": "Scout Sentinel",
  "version": "2.0.0",
  "description": "Spatial ambient intelligence for the web. One orb. One HUD. Inline pins. Selection lens.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/analyzers/job.js",
        "content/analyzers/social.js",
        "content/analyzers/shopping.js",
        "content/analyzers/news.js",
        "content/analyzers/chat.js",
        "content/sentinel/sentinel.js",
        "content/content.js"
      ],
      "css": ["content/sentinel/sentinel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scout Sentinel"
  },
  "icons": {},
  "web_accessible_resources": [
    {
      "resources": ["content/sentinel/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
