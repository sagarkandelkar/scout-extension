{
  "manifest_version": 3,
  "name": "Scout — Surfing Co-Pilot",
  "version": "1.0.0",
  "description": "Context-aware AI guidance for every site you visit. Local-first.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/analyzers/job.js",
        "content/analyzers/social.js",
        "content/analyzers/shopping.js",
        "content/analyzers/news.js",
        "content/ui/overlay.js",
        "content/content.js"
      ],
      "css": ["content/ui/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/scout16.png",
      "48": "icons/scout48.png",
      "128": "icons/scout128.png"
    }
  },
  "icons": {
    "16": "icons/scout16.png",
    "48": "icons/scout48.png",
    "128": "icons/scout128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/ui/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
